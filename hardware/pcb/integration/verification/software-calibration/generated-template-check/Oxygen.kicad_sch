	(text "5  |  SETUP AND CABLE RULES"
		(at 242.57 170.18 0)
		(effects
			(font
				(size 1.524 1.524)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "91d69b0f-3a3c-4445-a542-109294037ad6")
	)
	(text "AIN0-AIN1 = O2 A; AIN2-AIN3 = O2 B.\nInternal 2.048 V reference; 20 SPS normal; signed data.\nStart gain 1, PGA bypass; raise gain only after headroom checks.\nIDAC and burn-out currents OFF. Pairs are multiplexed."
		(at 242.57 181.61 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "8c052d6d-3a82-4a37-9d33-8b09098a153e")
	)
	(text "No 50 ohm termination. No ground connection on SMB shell.\nCheck cell loading, reversed leads and power-off leakage\nwith the actual sensors before accepting readings."
		(at 242.57 200.66 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "886b6a3c-c69d-4ed8-bf6a-27277031ecaa")
	)
	(text "J402 is the owned SMB Male PCB connector. Verify its\nland pattern and mating sensor plug before manufacture.\nA disconnected/shorted cell can resemble 0% O2;\ncalibration and plausibility checks are required."
		(at 242.57 226.06 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "97dcf055-2a41-4def-9504-b6a1e8077279")
	)
