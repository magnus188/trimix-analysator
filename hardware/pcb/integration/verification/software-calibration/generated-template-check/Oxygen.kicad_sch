	(text "1.65 V nominal\nHe ADC AIN3 monitors this bias."
		(at 148.59 228.6 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "58c7ba27-7f18-408f-856f-c3c8fe403b6b")
	)
	(text "Both cell leads float.\nNeither sensor receives power."
		(at 148.59 253.365 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "6bda978a-48c0-45a5-920f-603d47a0cd78")
	)
	(rectangle
		(start 238.76 165.1)
