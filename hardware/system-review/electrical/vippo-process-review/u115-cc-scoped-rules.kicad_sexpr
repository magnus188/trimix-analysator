# PROPOSAL ONLY: append after generic via rules in an isolated test project.
# Requires exact selected-hole epoxy fill, copper cap, planarity approval, ENIG.
# Do not apply to an ordinary open/ink-plugged via. Native DRC is still required.
(rule "U115 AUXOFF exact filled capped via geometry"
 (condition "A.Type == 'Via' && A.NetName == 'USB_CC_INT_N' && A.Position_X == 13.6mm && A.Position_Y == 89.775mm")
 (constraint hole_size (min 0.20mm) (max 0.20mm))
 (constraint via_diameter (min 0.40mm) (max 0.40mm))
 (constraint annular_width (min 0.10mm)))
# Actual nominal gap is 0.125mm. 0.12mm retains 0.02mm over published 0.10mm
# pad/track process minimum. Only this masked extension versus pins 2/4 changes.
(rule "U115 AUXOFF masked via extension to adjacent manufacturer lands"
 (layer "B.Cu")
 (condition "A.Type == 'Via' && A.NetName == 'USB_CC_INT_N' && A.Position_X == 13.6mm && A.Position_Y == 89.775mm && B.Type == 'Pad' && B.memberOfFootprint('U115') && (B.Pad_Number == '2' || B.Pad_Number == '4')")
 (constraint clearance (min 0.12mm)))
(rule "U115 AUXOFF exact via foreign hole clearance retained"
 (condition "A.Type == 'Via' && A.NetName == 'USB_CC_INT_N' && A.Position_X == 13.6mm && A.Position_Y == 89.775mm")
 (constraint hole_clearance (min 0.20mm)))
